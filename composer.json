{
    "name": "goldencreepertech/automobile",
    "type": "library",
    "description": "Automobile: an installable Laravel package that ships a ready-made vehicle database (manufacturers, models, variants, vehicles, parts) with seed data and an optional REST API.",
    "keywords": ["laravel", "automobile", "vehicle-database", "vehicles", "seed-data"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {
        "darkaonline/l5-swagger": "^11.1",
        "doctrine/annotations": "^2.0",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/tinker": "^2.9",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6 || ^9.0",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "suggest": {
        "darkaonline/l5-swagger": "Render Swagger/OpenAPI docs for the bundled controllers (php artisan l5-swagger:generate)",
        "doctrine/annotations": "Required alongside l5-swagger to parse the controllers' @OA docblock annotations"
    },
    "autoload": {
        "psr-4": {
            "Automobile\\": "src/",
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --ansi"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev"
        },
        "laravel": {
            "dont-discover": [],
            "providers": [
                "Automobile\\AutomobileServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
