* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# --- Keep the Composer dist tarball to just the package ---
# Everything below is part of the bundled demo app or local tooling and is
# stripped from `composer require` (dist) installs via `git archive`.

/.github            export-ignore
/.editorconfig      export-ignore
/.env.example       export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.styleci.yml       export-ignore

/app                export-ignore
/bootstrap          export-ignore
/public             export-ignore
/resources          export-ignore
/storage            export-ignore
/tests              export-ignore
/artisan            export-ignore
/phpunit.xml        export-ignore
/pint.json          export-ignore
/package.json       export-ignore
/vite.config.js     export-ignore

/database/factories             export-ignore
/database/seeders               export-ignore
/database/migrations/host       export-ignore
/database/.gitignore            export-ignore

/routes/web.php     export-ignore
/routes/console.php export-ignore
/routes/api.php     export-ignore

# Demo-app config. The package ships only config/automobile.php + config/static_token.php.
/config/app.php          export-ignore
/config/auth.php         export-ignore
/config/cache.php        export-ignore
/config/database.php     export-ignore
/config/filesystems.php  export-ignore
/config/l5-swagger.php   export-ignore
/config/logging.php      export-ignore
/config/mail.php         export-ignore
/config/queue.php        export-ignore
/config/services.php     export-ignore
/config/session.php      export-ignore
